{
  "name": "tutor-link",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "docker:up": "node ./scripts/not-implemented.mjs docker:up",
    "docker:down": "node ./scripts/not-implemented.mjs docker:down",
    "db:migrate": "node ./scripts/not-implemented.mjs db:migrate",
    "db:seed": "node ./scripts/not-implemented.mjs db:seed",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
