# Copy to apps/api/.env and adjust if you overrode any docker:up port.
# apps/api/src/config/env.schema.ts validates all of these at boot.

# development | test | production
NODE_ENV=development
# Port the NestJS API listens on.
PORT=3001

# PostgreSQL (infra/docker/docker-compose.yml "postgres" service).
DATABASE_URL=postgresql://tutor_link:tutor_link_dev@localhost:5432/tutor_link

# Redis (infra/docker/docker-compose.yml "redis" service) — cache, BullMQ queues, rate limits.
REDIS_URL=redis://localhost:6379

# MinIO (infra/docker/docker-compose.yml "minio" service) — S3-compatible object storage.
S3_ENDPOINT=localhost
S3_PORT=9000
# true only once MinIO/S3 is served over TLS; false for local dev.
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=tutor_link
S3_SECRET_KEY=tutor_link_dev_minio
# Private bucket: everything with personal data (addresses, recordings, receipts).
S3_PRIVATE_BUCKET=tl-private
# Still private (07-security-safeguarding.md §8); served only through signed links.
S3_PUBLIC_BUCKET=tl-public-assets

# Mailpit (infra/docker/docker-compose.yml "mailpit" service) — local email capture, no real sending.
SMTP_HOST=localhost
SMTP_PORT=1025
