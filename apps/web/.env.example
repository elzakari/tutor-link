# Copy to apps/web/.env.local and adjust if you overrode apps/api's PORT.
# apps/web/lib/env.ts validates all of these — see that file's comments on
# why only NEXT_PUBLIC_* names are listed as reaching the browser.

# Public: inlined into the browser bundle at build time. The browser calls
# the API directly at this URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Server-only: read in Server Components, Route Handlers and Server Actions.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser bundle.
API_INTERNAL_URL=http://localhost:3001/api/v1
